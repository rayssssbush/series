<% layout('./layout/page.ejs') %> <% if (user) { %>
<h1>Привет <%= user.username %></h1>
<p>Добро пожаловать, вы успешно вошли в систему!</p>
<% } else { %>
<h1>Привет незалогиненный пользователь</h1>
<p>Пожалуйста, войдите в систему, чтобы получить доступ к страницам сайта.</p>
<% } %>

<h1><%= title %></h1>
<p>Welcome to <%= title %></p>
<p>Счетчик: <%= counter %></p>
